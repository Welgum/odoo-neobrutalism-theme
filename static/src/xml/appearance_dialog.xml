<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="neobrutalism_theme.AppearanceDialog">
        <Dialog title="title" size="'md'" bodyClass="'o_neo_appearance'">
            <p class="o_neo_eyebrow">NEO BRUTAL / ODOO 19</p>
            <h3 class="mb-3">Make work a little bolder.</h3>
            <label class="o_neo_enable d-flex align-items-center gap-3 mb-4">
                <input type="checkbox" class="form-check-input m-0"
                    t-att-checked="state.enabled" t-on-change="toggle"/>
                <span>Use Neobrutalism theme</span>
            </label>
            <p class="small text-muted">
                Use the sun or moon button in the top bar to switch between day and night mode for yourself.
            </p>
            <p class="small text-muted">
                Theme colors are managed by your administrator in Settings → Neo Brutal.
            </p>
            <fieldset class="mb-4" t-att-disabled="!state.enabled">
                <legend class="fs-6 fw-bold mb-2">Table spacing</legend>
                <div class="d-flex flex-wrap gap-4">
                    <label class="d-flex align-items-center gap-2">
                        <input type="radio" name="neo_density" value="comfortable"
                            t-att-checked="state.density === 'comfortable'" t-on-change="setDensity"/>
                        Comfortable
                    </label>
                    <label class="d-flex align-items-center gap-2">
                        <input type="radio" name="neo_density" value="compact"
                            t-att-checked="state.density === 'compact'" t-on-change="setDensity"/>
                        Compact
                    </label>
                </div>
            </fieldset>
            <p t-if="status.persistent" class="small text-muted mb-0">
                Changes apply immediately and are saved for your user and database in this browser.
            </p>
            <p t-else="" class="small text-warning mb-0" role="status">
                Browser storage is unavailable. Changes last until this page is reloaded.
            </p>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary" t-on-click="props.close">Done</button>
                <button type="button" class="btn btn-secondary" t-on-click="reset">Reset defaults</button>
            </t>
        </Dialog>
    </t>
</templates>
