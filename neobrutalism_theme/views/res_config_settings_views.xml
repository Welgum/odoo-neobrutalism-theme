<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.neobrutalism</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Neo Brutal" string="Neo Brutal"
                     data-key="neobrutalism_theme" groups="base.group_system">
                    <h2>Appearance for all users</h2>
                    <div class="row mt16 o_settings_container" name="neo_appearance">
                        <div class="col-12 col-lg-6 o_setting_box" id="neo_accent_preset_setting">
                            <div class="o_setting_right_pane">
                                <label for="neo_accent_preset" string="Accent color"/>
                                <div class="text-muted mb-3">
                                    Choose one of seven presets for navigation, primary buttons and active tabs.
                                    Save and reload Odoo to apply it for all users.
                                    Only Settings administrators can change this selection.
                                </div>
                                <field name="neo_accent_preset" widget="radio" class="o_neo_accent_presets"/>
                                <div class="text-muted mt-3">
                                    Each preset includes matching highlights and readable button labels.
                                    Backgrounds, text, and success, warning and error colors retain their theme defaults.
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Personal appearance</h2>
                    <div class="row mt16 o_settings_container" name="neo_personal_appearance">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_right_pane text-muted">
                                Each user switches day or night mode with the sun/moon button in the top bar.
                                The accent preset works in both modes.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="action_neo_theme_settings" model="ir.actions.act_window">
        <field name="name">Neo Brutal Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'neobrutalism_theme', 'bin_size': False}</field>
    </record>
    <menuitem id="menu_neo_theme_settings" name="Neo Brutal" parent="base.menu_administration"
              action="action_neo_theme_settings" groups="base.group_system" sequence="20"/>
</odoo>
